{
  "name": "marcelocadori-com-br",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional estático de Marcelo Cadori — mecânica, lataria e pintura.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-server",
    "build": "npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
