# Copie para .env (ignorado pelo git) para desenvolvimento local.
# No GitHub: Settings > Secrets and variables > Actions > aba "Variables" (não precisa ser Secret).
# Tudo é opcional: o build funciona sem nada, mas o site só converte com o WhatsApp configurado.

VITE_SITE_URL=https://marcelocadori.com.br

# WhatsApp só com dígitos, com DDI+DDD: ex. 5551999999999
VITE_WHATSAPP_NUMBER=
VITE_EMAIL=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=

# Endereço (habilita SEO local / JSON-LD AutoRepair com endereço)
VITE_ADDRESS_STREET=
VITE_ADDRESS_CITY=
VITE_ADDRESS_STATE=
VITE_ADDRESS_ZIP=
VITE_GEO_LAT=
VITE_GEO_LNG=
VITE_MAPS_URL=
# Nome do local no Google (o mapa embutido mostra nota/avaliações). Ex.: Nome da Oficina Cidade
VITE_MAPS_QUERY=
# Horário: formato schema.org + texto legível
VITE_OPENING_HOURS_SCHEMA=Mo-Fr 08:00-18:00
VITE_OPENING_HOURS_TEXT=Segunda a sexta, das 8h às 18h

# Analytics / Tag Manager (recomendado: só o GTM; configure o GA4 dentro do GTM)
VITE_GTM_ID=
VITE_GA_ID=

# Verificação de propriedade (valor do "content" da meta tag)
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=
